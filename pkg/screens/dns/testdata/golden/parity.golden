  probes: systemctl is-active systemd-resolved.service; resolvectl --no-pager dns; resolvectl --no-pager domain
  write /etc/systemd/resolved.conf.d/zz-hardn.conf 0644, atomic
    | # Written by hardn: the system DNS servers for systemd-resolved.
    | # An empty assignment resets the list that earlier files built.
    | [Resolve]
    | DNS=
    | DNS=192.0.2.53 192.0.2.54 192.0.2.55
  write /etc/hardn/hardn.yml 0644, atomic
    +   - "192.0.2.55"
  mkdir /etc/systemd/resolved.conf.d 0755
  chmod /etc/systemd/resolved.conf.d 0755
  run systemctl try-reload-or-restart systemd-resolved.service
  backup: /etc/systemd/resolved.conf.d/zz-hardn.conf (absent before: the rollback removes it), /etc/hardn/hardn.yml; journal: journalled first; findings: DNS_PER_LINK
