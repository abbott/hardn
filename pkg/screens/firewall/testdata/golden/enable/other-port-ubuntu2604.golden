   ␛[38;2;129;134;156m-␛[m  ␛[38;2;192;196;216mInstall hardn's boot unit␛[m$
      ␛[38;2;129;134;156m/etc/systemd/system/hardn-boot.service␛[m$
      ␛[38;2;86;91;107m@@ -0,0 +1,23 @@␛[m$
      ␛[38;2;112;212;127m+# hardn's boot unit (P-34 (c);␛[m$
      ␛[38;2;112;212;127m↪ docs/safety/revert-boot.md). hardn installs␛[m$
      ␛[38;2;112;212;127m+# it before it arms the revert timer of a change that␛[m$
      ␛[38;2;112;212;127m↪ could lock you out, and␛[m$
      ␛[38;2;112;212;127m+# removes it at a boot that finds no change␛[m$
      ␛[38;2;112;212;127m↪ journalled.␛[m$
      ␛[38;2;112;212;127m+#␛[m$
      ␛[38;2;112;212;127m+# At boot, before sshd reads its files: re-arm the␛[m$
      ␛[38;2;112;212;127m↪ revert timer of a change␛[m$
      ␛[38;2;112;212;127m+# waiting for "hardn confirm", for what remains of␛[m$
      ␛[38;2;112;212;127m↪ its window, or roll the␛[m$
      ␛[38;2;112;212;127m+# change back when its deadline has passed. Ordering␛[m$
      ␛[38;2;112;212;127m↪ only: sshd starts␛[m$
      ␛[38;2;112;212;127m+# whatever this unit does.␛[m$
      ␛[38;2;112;212;127m+[Unit]␛[m$
      ␛[38;2;112;212;127m+Description=hardn: re-arm or run the revert timer of␛[m$
      ␛[38;2;112;212;127m↪ an unconfirmed change␛[m$
      ␛[38;2;112;212;127m+DefaultDependencies=no␛[m$
      ␛[38;2;112;212;127m+After=local-fs.target sysinit.target ufw.service␛[m$
      ␛[38;2;112;212;127m+Before=ssh.service ssh.socket sshd.service␛[m$
      ␛[38;2;112;212;127m↪ sshd.socket shutdown.target␛[m$
      ␛[38;2;112;212;127m+Conflicts=shutdown.target␛[m$
      ␛[38;2;112;212;127m+␛[m$
      ␛[38;2;112;212;127m+[Service]␛[m$
      ␛[38;2;112;212;127m+Type=oneshot␛[m$
      ␛[38;2;112;212;127m+RemainAfterExit=yes␛[m$
      ␛[38;2;112;212;127m+ExecStart=/usr/local/bin/hardn rollback --boot␛[m$
      ␛[38;2;112;212;127m+TimeoutStartSec=7min␛[m$
      ␛[38;2;112;212;127m+␛[m$
      ␛[38;2;112;212;127m+[Install]␛[m$
      ␛[38;2;112;212;127m+WantedBy=multi-user.target␛[m$
      ␛[38;2;231;70;105m-not installed␛[m$
      ␛[38;2;112;212;127m+installed and enabled␛[m$
      ␛[38;2;129;134;156m$ systemd-analyze verify --recursive-errors=no␛[m$
      ␛[38;2;129;134;156m↪ /run/hardn/20261102T120000Z-00000000/hardn-boot.serv␛[m$
      ␛[38;2;129;134;156m↪ice␛[m$
      ␛[38;2;129;134;156m$ systemctl --no-reload enable hardn-boot.service␛[m$
