=== plain-80: width 80, height 24, profile notty, dark, glyphs ascii, plain
# UFW Firewall Configuration ###################################$
$
  [ ] Firewall             Not Configured inactive$
$
  ufw ----------------------------------------------------------$
$
  [+] Installed            Yes$
  [ ] Status               Inactive$
   -  Incoming policy      Deny$
  [ ] At boot              No$
$
  SSH ----------------------------------------------------------$
$
   -  [::]:22              Not filtered$
   -  0.0.0.0:22           Not filtered$
$
  Rules --------------------------------------------------------$
$
   -  No firewall rules configured$
$
  Select an option$
$
   1) Enable firewall      Let SSH through, then start ufw$
                           [ ] Lockout risk$
   2) Application Profiles Add, remove, apply$
   3) Trusted Interfaces   Add, remove, apply$
$
   0) Return$
$
    > Option [0-3 or q]: 1$
$
  Checking the host...$
$
# Enable Firewall ##############################################$
$
  ufw ----------------------------------------------------------$
$
  [+] Status               Active$
  [+] Incoming policy      Deny$
  [+] At boot              Yes$
  [ ] ufw will block 8000/tcp (vaultwarden). To keep it open,$
      run ufw allow 8000/tcp first.$
$
   -  Install hardn's boot unit$
      /etc/systemd/system/hardn-boot.service$
      @@ -0,0 +1,23 @@$
      +# hardn's boot unit (P-34 (c);$
      | docs/safety/revert-boot.md). hardn installs$
      +# it before it arms the revert timer of a change that$
      | could lock you out, and$
      +# removes it at a boot that finds no change journalled.$
      +#$
      +# At boot, before sshd reads its files: re-arm the revert$
      | timer of a change$
      +# waiting for "hardn confirm", for what remains of its$
      | window, or roll the$
      +# change back when its deadline has passed. Ordering$
      | only: sshd starts$
      +# whatever this unit does.$
      +[Unit]$
      +Description=hardn: re-arm or run the revert timer of an$
      | unconfirmed change$
      +DefaultDependencies=no$
      +After=local-fs.target sysinit.target ufw.service$
      +Before=ssh.service ssh.socket sshd.service sshd.socket$
      | shutdown.target$
      +Conflicts=shutdown.target$
      +$
      +[Service]$
      +Type=oneshot$
      +RemainAfterExit=yes$
      +ExecStart=/usr/local/bin/hardn rollback --boot$
      +TimeoutStartSec=7min$
      +$
      +[Install]$
      +WantedBy=multi-user.target$
      -not installed$
      +installed and enabled$
      $ systemd-analyze verify --recursive-errors=no$
      | /run/hardn/20261102T120000Z-00000000/hardn-boot.service$
      $ systemctl --no-reload enable hardn-boot.service$
$
  [ ] Lockout risk$
      ufw: allow 22/tcp; enable$
$
      ufw$
      -inactive$
      +active$
      $ ufw allow 22/tcp$
      $ ufw --force enable$
$
  Enable the firewall?$
$
  Type the hostname [host-01, 0 or q]: 0$
$
