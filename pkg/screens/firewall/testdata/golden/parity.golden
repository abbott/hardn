  start: os=debian version=13 codename=trixie proxmox=false; cfg.SshPort 2230; 1 profiles
  probes: dpkg-query -W "--showformat=${Status}" pve-manager -> ok; which ufw -> ok
  run ufw default deny incoming
  run ufw default allow outgoing
  run ufw disable
  run ufw reset
  run ufw allow 2230/tcp comment "SSH access"
  run sh -c "yes | ufw enable"
  hardn -n: refused, exit status 2: hardn: -n/--dry-run only previews changes, so it can't be combined with -w/--configure-ufw, which applies them. Nothing was changed.
new path: -w's new form: Incoming{ActionEnable} through the engine as runControls builds it, decision 4's question to come in unit (d); the screen's Enable leaves the same
  probes: sshd -T -f /etc/ssh/sshd_config; ss -Htln; ufw status verbose; systemctl is-enabled ufw.service
  write /etc/systemd/system/hardn-boot.service 0644, atomic
    | # hardn's boot unit (P-34 (c); docs/safety/revert-boot.md). hardn installs
    | # it before it arms the revert timer of a change that could lock you out, and
    | # removes it at a boot that finds no change journalled.
    | #
    | # At boot, before sshd reads its files: re-arm the revert timer of a change
    | # waiting for "hardn confirm", for what remains of its window, or roll the
    | # change back when its deadline has passed. Ordering only: sshd starts
    | # whatever this unit does.
    | [Unit]
    | Description=hardn: re-arm or run the revert timer of an unconfirmed change
    | DefaultDependencies=no
    | After=local-fs.target sysinit.target ufw.service
    | Before=ssh.service ssh.socket shutdown.target
    | Conflicts=shutdown.target
    |
    | [Service]
    | Type=oneshot
    | RemainAfterExit=yes
    | ExecStart=/usr/local/bin/hardn rollback --boot
    | TimeoutStartSec=7min
    |
    | [Install]
    | WantedBy=multi-user.target
  run ufw allow 2230/tcp
  run ufw --force enable
  backup: none; journal: journalled first; findings: none
