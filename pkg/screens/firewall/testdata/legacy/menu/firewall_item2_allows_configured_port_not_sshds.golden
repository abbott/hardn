# The repository's calls, in order:
  1 exec   which ufw -> ok
  2 exec   ufw status -> ok
  3 stat   /etc/pve -> not-exist
  4 exec   dpkg-query -W "--showformat=${Status}" pve-manager -> ok
  5 exec   which ufw -> ok
  6 exec   ufw default deny incoming -> ok
  7 exec   ufw default allow outgoing -> ok
  8 exec   ufw disable -> ok
  9 exec   ufw reset -> ok
 10 exec   ufw allow 2230/tcp comment "SSH access" -> ok
 11 exec   sh -c "yes | ufw enable" -> ok
