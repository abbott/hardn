=== plain-80: width 80, height 24, profile notty, dark, glyphs ascii, plain
   -  Install hardn's boot unit, which re-arms the revert timer$
      after a reboot$
      /etc/systemd/system/hardn-boot.service$
      @@ -0,0 +1,23 @@$
      +# hardn's boot unit (P-34 (c);$
      | docs/safety/revert-boot.md). hardn installs$
      +# it before it arms the revert timer of a change that$
      | could lock you out, and$
      +# removes it at a boot that finds no change journalled.$
      +#$
      +# At boot, before sshd reads its files: re-arm the revert$
      | timer of a change$
      +# waiting for "hardn confirm", for what remains of its$
      | window, or roll the$
      +# change back when its deadline has passed. Ordering$
      | only: sshd starts$
      +# whatever this unit does.$
      +[Unit]$
      +Description=hardn: re-arm or run the revert timer of an$
      | unconfirmed change$
      +DefaultDependencies=no$
      +After=local-fs.target sysinit.target ufw.service$
      +Before=ssh.service ssh.socket shutdown.target$
      +Conflicts=shutdown.target$
      +$
      +[Service]$
      +Type=oneshot$
      +RemainAfterExit=yes$
      +ExecStart=/usr/local/bin/hardn rollback --boot$
      +TimeoutStartSec=7min$
      +$
      +[Install]$
      +WantedBy=multi-user.target$
      -not installed$
      +installed and enabled$
      $ systemd-analyze verify --recursive-errors=no$
      | /run/hardn/20261019T120000Z-1a2b3c4d/hardn-boot.service$
      $ systemctl --no-reload enable hardn-boot.service$
$
  [*] Lockout risk$
      Allow 2230/tcp in ufw before sshd listens on it$
$
      ufw$
      -22/tcp ALLOW IN Anywhere$
      +22/tcp ALLOW IN Anywhere$
      +2230/tcp ALLOW IN Anywhere$
      $ ufw allow 2230/tcp$
$
  [*] Lockout risk$
      Set Port 2230 in /etc/ssh/sshd_config.d/00-hardn.conf,$
      keeping Port 22 until confirmed$
$
      /etc/ssh/sshd_config.d/00-hardn.conf$
      @@ -1,2 +1,3 @@$
       # Managed by hardn$
       Port 22$
      +Port 2230$
$
  [*] Lockout risk$
      Reload ssh.service, which keeps established sessions$
$
      ssh.service$
      $ systemctl reload ssh.service$
$
  [*] Lockout risk$
      Check that sshd listens on 22 and 2230$
$
      sshd$
      $ sshd -T$
      $ ss -Htlnp$
$
  [i] Info: No actual changes were made to your system.$
$
  [*] Warning: PasswordAuthentication yes in 50-cloud-init.conf$
      is read before 00-hardn.conf, so sshd uses it$
      (SSHD_OVERRIDDEN, /etc/ssh/sshd_config.d/50-cloud-$
      init.conf:1)$
$

