=== plain-80: width 80, height 24, profile notty, dark, glyphs ascii, plain
   -  Set the nameservers$
      /etc/resolv.conf$
      @@ -1,3 +1,4 @@$
       # Generated by dhcpcd from eth0.dhcp$
       search example.net$
      -nameserver 192.0.2.1$
      +nameserver 1.1.1.1$
      +nameserver 1.0.0.1$
$
   -  Save the configuration$
      /etc/hardn/hardn.yml$
      @@ -1,5 +1,51 @@$
      -# hardn's configuration (web-01.example.net)$
       username: alice$
      +logFile: /var/log/hardn.log$
      +dryRun: false$
      +enableBackups: true$
      +backupPath: /var/backups/hardn$
      +dmzSubnet: ""$
       nameservers:$
      -  - "192.0.2.54"$
      -  - "2001:db8::54"$
      +    - 1.1.1.1$
      +    - 1.0.0.1$
      +sshPort: 22$
      +permitRootLogin: "no"$
      +sshAllowedUsers: []$
      +sshListenAddress: 0.0.0.0$
      +sshKeyPath: .ssh_%u$
      +sshConfigFile: /etc/ssh/sshd_config.d/hardn.conf$
      +sudoNoPassword: true$
      +sshKeys: []$
      +linuxCorePackages: []$
      +linuxDmzPackages: []$
      +linuxLabPackages: []$
      +pythonPackages: []$
      +nonWslPythonPackages: []$
      +pythonPipPackages: []$
      +alpineCorePackages: []$
      +alpineDmzPackages: []$
      +alpineLabPackages: []$
      +alpinePythonPackages: []$
      +debianRepos: []$
      +proxmoxSrcRepos: []$
      +proxmoxCephRepo: []$
      +proxmoxEnterpriseRepo: []$
      +proxmoxPackagePatterns: []$
      +alpineTestingRepo: false$
      +ufwAppProfiles: []$
      +ufwDefaultIncomingPolicy: ""$
      +ufwDefaultOutgoingPolicy: ""$
      +ufwAllowedPorts: []$
      +useUvPackageManager: false$
      +enableAppArmor: false$
      +enableLynis: false$
      +enableUnattendedUpgrades: false$
      +enableUfwSshPolicy: false$
      +configureDns: false$
      +disableRootSSH: false$
      +lang: ""$
      +language: ""$
      +lcAll: ""$
      +tz: ""$
      +pythonUnbuffered: "1"$
      +logsconfig:$
      +    logfilepath: ""$
$
  No actual changes were made to your system.$
$
# Warning$
# dhcpcd may rewrite /etc/resolv.conf on a lease$
# (DNS_DHCP_CLIENT, /usr/sbin/dhcpcd)$
# Saving hardn.yml loses its comments (CONFIG_COMMENTS_LOST,$
# /etc/hardn/hardn.yml)$
$

