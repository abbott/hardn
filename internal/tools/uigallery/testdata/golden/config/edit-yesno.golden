=== plain-80: width 80, height 24, profile notty, dark, glyphs ascii, plain
  config edit-yesno --------------------------------------------$
$
# Note$
# Proposed: no Figma frame. A yes/no key: nothing typed. The$
# plan with the key turned over, and the question naming the$
# value.$
$
# Edit a setting ###############################################$
$
   1) username             george$
   2) sshKeys              1 key$
   3) sshPort              2222$
   4) disableRootSSH       true$
   5) enableUfwSshPolicy   true$
   6) configureDns         true$
   7) syslogServers        None$
   8) ntpServers           None$
   9) kernel               false$
  10) confirmTimeout       3m$
  11) checkReleases        false$
  12) enableAutoUpdates    true$
$
   0) Return$
$
    > Option [0-12 or q]: $
$
# kernel #######################################################$
$
   -  Save the configuration$
      /etc/hardn/hardn.yml$
      @@ -14,3 +14,4 @@$
         - 1.1.1.1$
         - 1.0.0.1$
       enableAutoUpdates: true$
      +kernel: true$
$
  Save kernel: true? [y/N, 0 or q]: $
$
