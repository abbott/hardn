=== plain-80: width 80, height 24, profile notty, dark, glyphs ascii, plain
  config unused ------------------------------------------------$
$
# Note$
# Proposed: no Figma frame. The file also sets sudoNoPassword,$
# enableLynis, sshListenAddress, logFile and permitRootLogin,$
# which nothing reads: the Not used section.$
$
# Configuration ################################################$
$
  File ---------------------------------------------------------$
$
   -  Path                 /etc/hardn/hardn.yml$
   -  From                 Search path$
$
  Users --------------------------------------------------------$
$
   -  username             george$
   -  adminNoPassword      false (default)$
   -  sshKeys              1 key$
$
  SSH ----------------------------------------------------------$
$
   -  sshPort              2222$
   -  disableRootSSH       true$
   -  sshConfigFile        /etc/ssh/sshd_config.d/hardn.conf...$
$
  Firewall -----------------------------------------------------$
$
   -  enableUfwSshPolicy   true$
   -  ufwAppProfiles       tailscale$
   -  ufwTrustedInterfaces None (default)$
$
  DNS ----------------------------------------------------------$
$
   -  configureDns         true$
   -  nameservers          2: 1.1.1.1, 1.0.0.1$
$
  Auto Updates -------------------------------------------------$
$
   -  enableUnattendedUpgrades$
      true$
$
  Backup -------------------------------------------------------$
$
   -  enableBackups        true (default)$
   -  backupPath           /var/backups/hardn (default)$
$
  General ------------------------------------------------------$
$
   -  dryRun               false (default)$
   -  confirmTimeout       3m (default)$
$
  Not used -----------------------------------------------------$
$
  [ ] logFile              /srv/log/hardn.log$
  [ ] permitRootLogin      yes$
  [ ] sshListenAddress     192.0.2.10$
  [ ] enableLynis          true$
  [ ] sudoNoPassword       false$
$
   0) Return$
$
    > Option [0 or q]:$
$
$

