=== plain-80: width 80, height 24, profile notty, dark, glyphs ascii, plain
  config edit-port ---------------------------------------------$
$
# Note$
# Proposed: no Figma frame. sshPort: 99999 refused under the$
# field and asked again; then the save's plan, the line that$
# changes, and the question.$
$
# Edit a setting ###############################################$
$
   1) username             george$
   2) sshKeys              1 key$
   3) sshPort              2222$
   4) disableRootSSH       true$
   5) enableUfwSshPolicy   true$
   6) configureDns         true$
   7) syslogServers        None$
   8) ntpServers           None$
   9) kernel               false$
  10) confirmTimeout       3m$
  11) checkReleases        false$
  12) enableUnattendedUpgrades  true$
$
   0) Return$
$
    > Option [0-12 or q]: $
$
# sshPort ######################################################$
$
  Enter SSH port [2222] [0 or q]: $
  (x) Not a port between 1 and 65535$
  Enter SSH port [2222] [0 or q]: $
$
   -  Save the configuration$
      /etc/hardn/hardn.yml$
      @@ -1,7 +1,7 @@$
       username: george$
       sshKeys:$
         - "ssh-ed25519$
      | AAAAC3NzaC1lZDI1NTE5AAAAIAEBAQEBAQEBAQEBAQEBAQEBAQEBAQEB$
      |AQEBAQEBAQEB george@laptop-1"$
      -sshPort: 2222$
      +sshPort: 2022$
       disableRootSSH: true$
       enableUfwSshPolicy: true$
       ufwAppProfiles:$
$
  Save sshPort? [y/N, 0 or q]: $
$
$

