=== plain-80: width 80, height 24, profile notty, dark, glyphs ascii, plain
  config edit-syslog-remove ------------------------------------$
$
# Note$
# Proposed: no Figma frame. syslogServers: Remove by number,$
# then the plan.$
$
# Edit a setting ###############################################$
$
   1) username             george$
   2) sshKeys              1 key$
   3) sshPort              2222$
   4) disableRootSSH       true$
   5) enableUfwSshPolicy   true$
   6) configureDns         true$
   7) syslogServers        logs.example.net, 192.0.2.51, 192....$
   8) ntpServers           None$
   9) kernel               false$
  10) confirmTimeout       3m$
  11) checkReleases        false$
  12) enableUnattendedUpgrades  true$
$
   0) Return$
$
    > Option [0-12 or q]: $
$
# syslogServers ################################################$
$
  Servers ------------------------------------------------------$
$
   -  Server               logs.example.net:6514 TLS$
   -  Server               192.0.2.51:514 TCP$
   -  Server               192.0.2.52:514 UDP$
$
   1) Add server$
   2) Remove server$
$
   0) Return$
$
    > Option [0-2 or q]: $
$
# syslogServers ################################################$
$
  Select a server to remove$
$
   1) logs.example.net:6514 TLS$
   2) 192.0.2.51:514 TCP$
   3) 192.0.2.52:514 UDP$
$
    > Option [1-3, 0 or q]: $
  Select a server to remove: 192.0.2.51:514 TCP$
$
   -  Save the configuration$
      /etc/hardn/hardn.yml$
      @@ -18,6 +18,5 @@$
         - server: "logs.example.net"$
           protocol: tls$
           caFile: "/etc/ssl/lab-ca.pem"$
      -  - server: "192.0.2.51"$
         - server: "192.0.2.52"$
           protocol: udp$
$
  Save syslogServers? [y/N, 0 or q]: $
$
$

