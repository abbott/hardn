      ␛[38;2;112;212;127m+# before: net.ipv4.conf.lo.send_redirects = 1␛[m$
      ␛[38;2;112;212;127m+net.ipv4.conf.*.send_redirects = 0␛[m$
      ␛[38;2;112;212;127m+# before: kernel.yama.ptrace_scope = 0␛[m$
      ␛[38;2;112;212;127m+kernel.yama.ptrace_scope = 1␛[m$
