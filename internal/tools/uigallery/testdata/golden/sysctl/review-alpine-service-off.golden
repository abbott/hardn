      ␛[38;2;112;212;127m+net.ipv6.conf.eth0.accept_redirects = 0␛[m$
      ␛[38;2;112;212;127m+# before: net.ipv6.conf.lo.accept_redirects = 1␛[m$
      ␛[38;2;112;212;127m+net.ipv6.conf.lo.accept_redirects = 0␛[m$
      ␛[38;2;112;212;127m+# before: net.ipv4.conf.all.send_redirects = 1␛[m$
      ␛[38;2;112;212;127m+net.ipv4.conf.all.send_redirects = 0␛[m$
      ␛[38;2;112;212;127m+# before: net.ipv4.conf.default.send_redirects = 1␛[m$
      ␛[38;2;112;212;127m+net.ipv4.conf.default.send_redirects = 0␛[m$
      ␛[38;2;112;212;127m+# before: net.ipv4.conf.eth0.send_redirects = 1␛[m$
      ␛[38;2;112;212;127m+net.ipv4.conf.eth0.send_redirects = 0␛[m$
      ␛[38;2;112;212;127m+# before: net.ipv4.conf.lo.send_redirects = 1␛[m$
      ␛[38;2;112;212;127m+net.ipv4.conf.lo.send_redirects = 0␛[m$
      ␛[38;2;112;212;127m+# before: kernel.kptr_restrict = 0␛[m$
      ␛[38;2;112;212;127m+kernel.kptr_restrict = 1␛[m$
