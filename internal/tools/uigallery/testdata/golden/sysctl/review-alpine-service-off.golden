   ␛[38;2;129;134;156m-␛[m  ␛[38;2;192;196;216mSet the values now␛[m$
      ␛[38;2;129;134;156m$ sysctl -w net.ipv4.conf.eth0.accept_redirects=0␛[m$
      ␛[38;2;129;134;156m$ sysctl -w net.ipv4.conf.lo.accept_redirects=0␛[m$
      ␛[38;2;129;134;156m$ sysctl -w net.ipv6.conf.eth0.accept_redirects=0␛[m$
      ␛[38;2;129;134;156m$ sysctl -w net.ipv6.conf.lo.accept_redirects=0␛[m$
      ␛[38;2;129;134;156m$ sysctl -w net.ipv4.conf.all.send_redirects=0␛[m$
      ␛[38;2;129;134;156m$ sysctl -w net.ipv4.conf.default.send_redirects=0␛[m$
      ␛[38;2;129;134;156m$ sysctl -w net.ipv4.conf.eth0.send_redirects=0␛[m$
      ␛[38;2;129;134;156m$ sysctl -w net.ipv4.conf.lo.send_redirects=0␛[m$
      ␛[38;2;129;134;156m$ sysctl -w kernel.kptr_restrict=1␛[m$
      ␛[38;2;129;134;156m$ sysctl -w fs.protected_fifos=1␛[m$
      ␛[38;2;129;134;156m$ sysctl -w fs.protected_regular=1␛[m$
