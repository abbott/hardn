   ␛[38;2;129;134;156m-␛[m  ␛[38;2;192;196;216mWrite hardn's kernel settings␛[m$
      ␛[38;2;129;134;156m/etc/sysctl.d/90-hardn.conf␛[m$
      ␛[38;2;86;91;107m@@ -0,0 +1,23 @@␛[m$
      ␛[38;2;112;212;127m+# Written by hardn (Kernel Settings).␛[m$
      ␛[38;2;112;212;127m+# before: net.ipv4.conf.eth0.accept_redirects = 1␛[m$
      ␛[38;2;112;212;127m+net.ipv4.conf.eth0.accept_redirects = 0␛[m$
      ␛[38;2;112;212;127m+# before: net.ipv4.conf.lo.accept_redirects = 1␛[m$
      ␛[38;2;112;212;127m+net.ipv4.conf.lo.accept_redirects = 0␛[m$
