=== plain-80: width 80, height 24, profile notty, dark, glyphs ascii, plain
  timesync review-remove ---------------------------------------$
$
# Note$
# Proposed: no Figma frame. hardn's Remove servers: hardn's file$
# deleted, Ubuntu's pools as they were, and chrony told to read$
# again.$
$
  Checking the host...$
$
# Remove servers ###############################################$
$
# Note$
# The host's own servers are used again.$
$
  Time ---------------------------------------------------------$
$
   -  Server               1.ntp.ubuntu.com$
   -  Server               2.ntp.ubuntu.com$
   -  Server               3.ntp.ubuntu.com$
   -  Server               4.ntp.ubuntu.com$
   -  Server               ntp-bootstrap.ubuntu.com$
$
   -  Delete hardn's time servers$
      /etc/chrony/sources.d/hardn.sources$
      @@ -1,3 +0,0 @@$
      -# Written by hardn (Time Sync).$
      -server 192.0.2.10 iburst$
      -server 192.0.2.11 iburst$
$
   -  Switch Ubuntu's pools back on$
      /etc/chrony/sources.d/ubuntu-ntp-pools.sources$
      @@ -1,11 +1,11 @@$
       # Use NTS by default$
       # NTS uses an additional port to negotiate security:$
      | 4460/tcp$
       # The normal NTP port remains in use: 123/udp$
      -#hardn: pool 1.ntp.ubuntu.com iburst maxsources 1 nts$
      | prefer$
      -#hardn: pool 2.ntp.ubuntu.com iburst maxsources 1 nts$
      | prefer$
      -#hardn: pool 3.ntp.ubuntu.com iburst maxsources 1 nts$
      | prefer$
      -#hardn: pool 4.ntp.ubuntu.com iburst maxsources 1 nts$
      | prefer$
      +pool 1.ntp.ubuntu.com iburst maxsources 1 nts prefer$
      +pool 2.ntp.ubuntu.com iburst maxsources 1 nts prefer$
      +pool 3.ntp.ubuntu.com iburst maxsources 1 nts prefer$
      +pool 4.ntp.ubuntu.com iburst maxsources 1 nts prefer$
       # The bootstrap server is needed by systems without a$
      | hardware clock, or a very$
       # large initial clock offset. The specified certificate$
      | set is defined in$
       # /etc/chrony/conf.d/ubuntu-nts.conf.$
      -#hardn: pool ntp-bootstrap.ubuntu.com iburst maxsources 1$
      | nts certset 1$
      +pool ntp-bootstrap.ubuntu.com iburst maxsources 1 nts$
      | certset 1$
      $ chronyc reload sources$
$
  Remove hardn's time servers? [y/N, 0 or q]: $
$
$

