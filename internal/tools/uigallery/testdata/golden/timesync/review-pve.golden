=== plain-80: width 80, height 24, profile notty, dark, glyphs ascii, plain
  timesync review-pve ------------------------------------------$
$
# Note$
# Proposed: no Figma frame. Set servers on a Proxmox VE 9 node:$
# hardn's file, Debian's pool commented out in chrony's main$
# file, a restart, and a line about the cluster.$
$
  Checking the host...$
$
# Set servers ##################################################$
$
# Note$
# hardn's servers take the place of the host's own. Remove$
# servers puts those back. On a cluster, set every node the same$
# way: the nodes need synchronised clocks.$
$
  Time ---------------------------------------------------------$
$
   -  Server               192.0.2.10 by hardn$
   -  Server               192.0.2.11 by hardn$
  [ ] Proxmox VE is a custom distribution: a change that is safe$
      on Debian can break it$
$
   -  Write hardn's time servers$
      /etc/chrony/sources.d/hardn.sources$
      @@ -0,0 +1,3 @@$
      +# Written by hardn (NTP Settings).$
      +server 192.0.2.10 iburst$
      +server 192.0.2.11 iburst$
$
   -  Switch off chrony's own servers$
      /etc/chrony/chrony.conf$
      @@ -1,7 +1,7 @@$
       confdir /etc/chrony/conf.d$
$
       # Use Debian vendor zone.$
      -pool 2.debian.pool.ntp.org iburst$
      +#hardn: pool 2.debian.pool.ntp.org iburst$
$
       # Use time sources from DHCP.$
       sourcedir /run/chrony-dhcp$
$
   -  Restart chrony$
      chrony$
      $ systemctl restart chrony$
$
  Set time servers? [y/N, 0 or q]: $
$
$

