=== plain-80: width 80, height 24, profile notty, dark, glyphs ascii, plain
  play environment/doas-overridden -----------------------------$
$
# Note$
# Play mode: hardn's own screens and prompts, on the real$
# plan/apply engine against a simulated host, hostfake's$
# recording host.System, whose commands a model of the host$
# answers. Nothing on this machine changes: every command and$
# file is the fake's, and its record is shown when play ends.$
$
# Info: environment/doas-overridden$
# web-01.example.net runs Alpine 3.23's cloud image, doas, as$
# the maintainer's VM; alice is in wheel, and the image's$
# /etc/doas.d/wheel.conf says permit nopass :wheel. alice ran$
# doas hardn. A local /etc/doas.d/zz-local.conf says permit$
# nopass :wheel too. hardn's rule for alice keeps HARDN_CONFIG,$
# but zz-local.conf's wins, so doas dropped it. Stopping$
# rewrites a rule that asks for alice's password.$
$
# Environment Variable Settings ################################$
$
  HARDN_CONFIG -------------------------------------------------$
$
   -  User                 alice$
  [ ] Under doas           Kept by hardn$
   -  /etc/doas.d/zz-local.conf may override hardn's rule$
   -  Value                Not set$
$
  Select an option$
$
   1) Under doas           Stop keeping HARDN_CONFIG$
                           [ ] Lockout risk$
   2) Guide                How to set HARDN_CONFIG$
$
   0) Return$
$
    > Enter selection [0-2 or q]: 1$
$
# Stop Keeping HARDN_CONFIG ####################################$
$
  HARDN_CONFIG -------------------------------------------------$
$
   -  User                 alice$
  [ ] Under doas           Not kept by hardn$
  [ ] /etc/doas.d/zz-local.conf may override hardn's rule$
$
   -  Install hardn's boot unit$
      /etc/init.d/hardn-boot$
      @@ -0,0 +1,23 @@$
      +#!/sbin/openrc-run$
      +# hardn's boot service (P-34 (c);$
      | docs/safety/revert-boot.md). hardn installs$
      +# it before it arms the revert timer of a change that$
      | could lock you out, and$
      +# removes it at a boot that finds no change journalled.$
      +#$
      +# At boot, before sshd starts: re-arm the revert timer of$
      | a change waiting$
      +# for "hardn confirm", for what remains of its window, or$
      | roll the change$
      +# back when its deadline has passed. Ordering only: sshd$
      | starts whatever$
      +# this service does.$
      +$
      +description="hardn: re-arm or run the revert timer of an$
      | unconfirmed change"$
      +$
      +depend() {$
      +    need localmount$
      +    after bootmisc firewall$
      +    before sshd$
      +}$
      +$
      +start() {$
      +    ebegin "hardn: checking the change journal"$
      +    /usr/local/bin/hardn rollback --boot$
      +    eend $?$
      +}$
      -not installed$
      +installed and enabled$
      $ sh -n /run/hardn/20261020T120000Z-xxxxxxxx/hardn-boot$
      $ rc-update add hardn-boot default$
$
  [ ] Lockout risk$
      Stop keeping HARDN_CONFIG$
$
      /etc/doas.d/zz-hardn-alice.conf$
      @@ -1,2 +1,2 @@$
       # Managed by hardn$
      -permit persist setenv { HARDN_CONFIG } alice$
      +permit persist alice$
$
  Stop keeping HARDN_CONFIG under doas?$
$
  Type the hostname [web-01, 0 or q]: web-01$
$
  [+] Install hardn's boot unit  Done$
  [+] Stop keeping HARDN_CONFIG  Done$
$
# Operation Successful$
$
# Warning$
# This change reverts automatically in 3:00$
# To keep it, open a new SSH session and run:$
$
      $ doas hardn confirm$
$
  Unless confirmed, change 20261020T120000Z-xxxxxxxx is rolled$
