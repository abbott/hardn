      ␛[38;2;112;212;127m+#␛[m$
      ␛[38;2;112;212;127m+# At boot, before sshd starts: re-arm the revert␛[m$
      ␛[38;2;112;212;127m↪ timer of a change waiting␛[m$
      ␛[38;2;112;212;127m+# for "hardn confirm", for what remains of its␛[m$
      ␛[38;2;112;212;127m↪ window, or roll the change␛[m$
      ␛[38;2;112;212;127m+# back when its deadline has passed. Ordering only:␛[m$
      ␛[38;2;112;212;127m↪ sshd starts whatever␛[m$
      ␛[38;2;112;212;127m+# this service does.␛[m$
      ␛[38;2;112;212;127m+␛[m$
      ␛[38;2;112;212;127m+description="hardn: re-arm or run the revert timer of␛[m$
      ␛[38;2;112;212;127m↪ an unconfirmed change"␛[m$
      ␛[38;2;112;212;127m+␛[m$
      ␛[38;2;112;212;127m+depend() {␛[m$
      ␛[38;2;112;212;127m+    need localmount␛[m$
      ␛[38;2;112;212;127m+    after bootmisc firewall␛[m$
      ␛[38;2;112;212;127m+    before sshd␛[m$
      ␛[38;2;112;212;127m+}␛[m$
      ␛[38;2;112;212;127m+␛[m$
      ␛[38;2;112;212;127m+start() {␛[m$
      ␛[38;2;112;212;127m+    ebegin "hardn: checking the change journal"␛[m$
      ␛[38;2;112;212;127m+    /usr/local/bin/hardn rollback --boot␛[m$
      ␛[38;2;112;212;127m+    eend $?␛[m$
      ␛[38;2;112;212;127m+}␛[m$
