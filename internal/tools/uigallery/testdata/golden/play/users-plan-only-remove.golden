=== plain-80: width 80, height 24, profile notty, dark, glyphs ascii, plain
  play users/second-admin --------------------------------------$
$
# Note$
# Play mode: hardn's own screens and prompts, on the real$
# plan/apply engine against a simulated host, hostfake's$
# recording host.System, whose commands a model of the host$
# answers. Nothing on this machine changes: every command and$
# file is the fake's, and its record is shown when play ends.$
$
# Info: users/second-admin$
# web-01.example.net runs Debian 13. debian13, but alice has a$
# password, one key and sudo by hardn-grant-alice (NOPASSWD), in$
# no sudo group.$
$
# User Management ##############################################$
$
  [+] User                 Configured non-root, sudo$
$
  george -------------------------------------------------------$
$
  [ ] Sudo                 Enabled, No password to ask for$
   -  Granted by           /etc/sudoers.d/90-cloud-init-users$
   -  SSH Keys             2 keys$
   -  Password             None$
$
  alice --------------------------------------------------------$
$
  [ ] Sudo                 Enabled, No password$
   -  Granted by           hardn$
   -  SSH Keys             1 key$
   -  Password             Set$
$
  Select an option$
$
   1) Manage User          Configure sudo, SSH keys$
   2) Create User          Configure a new user$
$
   0) Return$
$
    > Option [0-2 or q]: 1$
$
# Manage User ##################################################$
$
  Select an option$
$
   1) george$
   2) alice$
$
   0) Return$
$
    > Option [0-2 or q]: 2$
$
# Manage User ##################################################$
$
  Managing: [alice]$
$
  User Configuration -------------------------------------------$
$
  [ ] Sudo                 Enabled, No password$
   -  Granted by           hardn$
   -  SSH Keys             1 key$
   -  Password             Set$
$
  Select an option$
$
   1) Remove admin rights  Take them away$
   2) Ask for password     For admin rights$
   3) SSH Keys             Add or remove SSH keys$
$
   0) Return$
$
    > Option [0-3 or q]: 1$
$
# Remove admin rights ##########################################$
$
  User Configuration -------------------------------------------$
$
   -  Sudo                 Disabled$
$
   -  Install hardn's boot unit$
      /etc/systemd/system/hardn-boot.service$
      @@ -0,0 +1,23 @@$
      +# hardn's boot unit (P-34 (c);$
      | docs/safety/revert-boot.md). hardn installs$
      +# it before it arms the revert timer of a change that$
      | could lock you out, and$
      +# removes it at a boot that finds no change journalled.$
      +#$
      +# At boot, before sshd reads its files: re-arm the revert$
      | timer of a change$
      +# waiting for "hardn confirm", for what remains of its$
      | window, or roll the$
      +# change back when its deadline has passed. Ordering$
      | only: sshd starts$
      +# whatever this unit does.$
      +[Unit]$
      +Description=hardn: re-arm or run the revert timer of an$
      | unconfirmed change$
      +DefaultDependencies=no$
      +After=local-fs.target sysinit.target ufw.service$
      +Before=ssh.service ssh.socket sshd.service sshd.socket$
      | shutdown.target$
      +Conflicts=shutdown.target$
      +$
      +[Service]$
      +Type=oneshot$
      +RemainAfterExit=yes$
      +ExecStart=/usr/local/bin/hardn rollback --boot$
      +TimeoutStartSec=7min$
      +$
      +[Install]$
      +WantedBy=multi-user.target$
      -not installed$
      +installed and enabled$
      $ systemd-analyze verify --recursive-errors=no$
      | /run/hardn/20261020T120000Z-xxxxxxxx/hardn-boot.service$
      $ systemctl --no-reload enable hardn-boot.service$
$
  [ ] Lockout risk$
      Remove alice's sudo$
$
      /etc/sudoers.d/hardn-grant-alice$
      @@ -1,2 +0,0 @@$
      -# Managed by hardn$
      -alice ALL=(ALL) NOPASSWD: ALL$
$
  No actual changes were made to your system.$
$
# Manage User ##################################################$
$
  Managing: [alice]$
$
  User Configuration -------------------------------------------$
$
  [ ] Sudo                 Enabled, No password$
   -  Granted by           hardn$
   -  SSH Keys             1 key$
   -  Password             Set$
$
  Select an option$
$
   1) Remove admin rights  Take them away$
   2) Ask for password     For admin rights$
   3) SSH Keys             Add or remove SSH keys$
$
   0) Return$
$
    > Option [0-3 or q]: 0$
$
# Manage User ##################################################$
$
  Select an option$
$
   1) george$
   2) alice$
$
   0) Return$
$
    > Option [0-2 or q]: 0$
$
# User Management ##############################################$
$
  [+] User                 Configured non-root, sudo$
$
  george -------------------------------------------------------$
$
  [ ] Sudo                 Enabled, No password to ask for$
   -  Granted by           /etc/sudoers.d/90-cloud-init-users$
   -  SSH Keys             2 keys$
   -  Password             None$
$
  alice --------------------------------------------------------$
$
  [ ] Sudo                 Enabled, No password$
   -  Granted by           hardn$
   -  SSH Keys             1 key$
   -  Password             Set$
$
  Select an option$
$
   1) Manage User          Configure sudo, SSH keys$
   2) Create User          Configure a new user$
$
   0) Return$
$
    > Option [0-2 or q]: 0$
$
  simulated system ---------------------------------------------$
$
# Note$
# Nothing was applied.$
$

