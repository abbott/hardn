=== plain-80: width 80, height 24, profile notty, dark, glyphs ascii, plain
# play runall/fresh --------------------------------------------$
$
# Note$
# Play mode: hardn's own screens and prompts, on the real$
# plan/apply engine against a simulated host, hostfake's$
# recording host.System, whose commands a model of the host$
# answers. Nothing on this machine changes: every command and$
# file is the fake's, and its record is shown when play ends.$
$
# Info: runall/fresh$
# web-01.example.net runs Debian 13. Root alone, logged in by$
# key; no ufw, no unattended-upgrades. hardn.yml: george with a$
# key, port 22, two nameservers, backups on, and$
# enableUnattendedUpgrades, enableUfwSshPolicy, configureDns and$
# disableRootSSH true. The design problem: george doesn't exist$
# when root login is planned.$
$
# Run All ######################################################$
$
# Controls -----------------------------------------------------$
$
   -  User                 Create george, 1 key$
   -  Firewall             Refused: ufw isn't installed. Inst...$
   -  SSH Login            Refused: You're logged in as root...$
   -  SSH Auth             Nothing asked$
   -  SSH Port             Already as asked$
   -  AppArmor             Status only$
   -  Auto Updates         Turn on$
   -  DNS                  Set 2 nameservers$
   -  Backups              Used, not changed$
   -  Environment          Nothing asked$
$
  Select an option$
$
   1) Apply all            Plan, review, confirm$
$
   0) Return$
$
  > Enter your choice [0-1 or q]: 1$
$
# Warning$
# Firewall skipped: ufw isn't installed. Install it, then try$
# again.$
# SSH Login skipped: You're logged in as root over SSH. Turning$
# root login off would close the way you came in. Log in as an$
# admin and run hardn through sudo.$
$
# Apply all ####################################################$
$
# Run All ------------------------------------------------------$
$
   -  User                 Create george, 1 key$
   -  Auto Updates         Turn on$
   -  DNS                  Set 2 nameservers$
  [ ] dhcpcd may rewrite /etc/resolv.conf on a lease$
$
   -  Install unattended-upgrades$
      unattended-upgrades$
      -not installed$
      +installed$
      $ apt-get install -y unattended-upgrades$
$
   -  Create user george$
      /etc/passwd$
      -absent$
      +no password, key login$
      $ useradd --home-dir /home/george --create-home --shell$
      | /bin/bash george$
$
   -  Let george use sudo$
      /etc/sudoers.d/hardn-grant-george$
      @@ -0,0 +1,2 @@$
      +# Managed by hardn$
      +george ALL=(ALL) NOPASSWD: ALL$
$
   -  Add george's key$
      /home/george/.ssh/authorized_keys$
      @@ -0,0 +1 @@$
      +ssh-ed25519$
      | AAAAC3NzaC1lZDI1NTE5AAAAIAEBAQEBAQEBAQEBAQEBAQEBAQEBAQEB$
      |AQEBAQEBAQEB george@laptop-1$
      $ install -d -m 700 -o george -g george /home/george/.ssh$
$
   -  Turn on daily upgrades$
      /etc/apt/apt.conf.d/52hardn-auto-upgrades$
      @@ -0,0 +1,3 @@$
      +// Written by hardn (Auto Updates).$
      +APT::Periodic::Update-Package-Lists "1";$
      +APT::Periodic::Unattended-Upgrade "1";$
      $ apt-config dump APT::Periodic$
      | Unattended-Upgrade::Origins-Pattern$
      | Unattended-Upgrade::Allowed-Origins$
$
   -  Set the nameservers$
      /etc/resolv.conf$
      @@ -1,3 +1,4 @@$
       # Generated by dhcpcd from eth0.dhcp$
       search example.net$
      -nameserver 192.0.2.1$
      +nameserver 192.0.2.54$
      +nameserver 2001:db8::54$
$
   -  Record hardn's changes$
      /var/lib/hardn/controls/updates.auto.json$
$
  Apply this plan?$
$
  Type the hostname [web-01, 0 or q]: web-01$
$
  [+] Install unattended-upgrades  Done$
  [+] Create user george           Done$
  [+] Let george use sudo          Done$
  [+] Add george's key             Done$
  [+] Turn on daily upgrades       Done$
  [+] Set the nameservers          Done$
  [+] Record hardn's changes       Done$
$
# Operation Successful$
$
  Backup of /etc/resolv.conf kept in$
  /var/backups/hardn/20261020T120000Z-xxxxxxxx$
$
# Run All ######################################################$
$
# Controls -----------------------------------------------------$
$
   -  User                 Already as asked$
   -  Firewall             Refused: ufw isn't installed. Inst...$
   -  SSH Login            Refused: You're logged in as root...$
   -  SSH Auth             Nothing asked$
   -  SSH Port             Already as asked$
   -  AppArmor             Status only$
   -  Auto Updates         Already as asked$
   -  DNS                  Already as asked$
   -  Backups              Used, not changed$
   -  Environment          Nothing asked$
$
  Select an option$
$
   1) Apply all            Nothing to change$
$
   0) Return$
$
  > Enter your choice [0-1 or q]: 0$
$
# simulated system ---------------------------------------------$
$
# Info: runall/fresh$
# Recorded by the fake, not done: what each step ran on web-$
# 01.example.net, and the files it changed, in order; hardn's$
# own journal, run directory and backups left out.$
$
   -  Before the first change$
      $ apt-config dump APT::Periodic$
      | Unattended-Upgrade::Origins-Pattern$
      | Unattended-Upgrade::Allowed-Origins$
      $ apt-config dump Dir$
      $ apt-config dump APT::Periodic$
      | Unattended-Upgrade::Origins-Pattern$
      | Unattended-Upgrade::Allowed-Origins$
      $ apt-config dump APT::Periodic$
      | Unattended-Upgrade::Origins-Pattern$
      | Unattended-Upgrade::Allowed-Origins$
      $ apt-config dump APT::Periodic$
      | Unattended-Upgrade::Origins-Pattern$
      | Unattended-Upgrade::Allowed-Origins$
      $ apt-config dump Dir$
      $ apt-config dump APT::Periodic$
      | Unattended-Upgrade::Origins-Pattern$
      | Unattended-Upgrade::Allowed-Origins$
      $ apt-config dump APT::Periodic$
      | Unattended-Upgrade::Origins-Pattern$
      | Unattended-Upgrade::Allowed-Origins$
$
   -  Applied: Install unattended-upgrades$
      $ apt-get install -y unattended-upgrades$
$
   -  Applied: Create user george$
      $ useradd --home-dir /home/george --create-home --shell$
      | /bin/bash george$
$
   -  Applied: Let george use sudo$
      /etc/sudoers.d/hardn-grant-george$
$
   -  Applied: Add george's key$
      /home/george/.ssh/authorized_keys$
      $ install -d -m 700 -o george -g george /home/george/.ssh$
$
   -  Applied: Turn on daily upgrades$
      /etc/apt/apt.conf.d/52hardn-auto-upgrades$
      $ apt-config dump APT::Periodic$
      | Unattended-Upgrade::Origins-Pattern$
      | Unattended-Upgrade::Allowed-Origins$
$
   -  Applied: Set the nameservers$
      /etc/resolv.conf$
$
   -  Applied: Record hardn's changes$
      $ apt-config dump APT::Periodic$
      | Unattended-Upgrade::Origins-Pattern$
      | Unattended-Upgrade::Allowed-Origins$
$

