=== plain-80: width 80, height 24, profile notty, dark, glyphs ascii, plain
  play runall/alpine323 ----------------------------------------$
$
# Note$
# Play mode: hardn's own screens and prompts, on the real$
# plan/apply engine against a simulated host, hostfake's$
# recording host.System, whose commands a model of the host$
# answers. Nothing on this machine changes: every command and$
# file is the fake's, and its record is shown when play ends.$
$
# Info: runall/alpine323$
# web-01.example.net runs Alpine 3.23 (OpenRC). As the VM: no$
# PAM, root "!", george in wheel, no ufw, no apk-cron.$
# hardn.yml: george with a key, port 22, two nameservers,$
# backups on, and enableUnattendedUpgrades, enableUfwSshPolicy,$
# configureDns and disableRootSSH true.$
$
# Run All ######################################################$
$
  Controls -----------------------------------------------------$
$
   -  User                 Already as asked$
   -  Firewall             Refused: hardn can't tell which po...$
   -  SSH Login            Root login off$
   -  SSH Auth             Nothing asked$
   -  SSH Port             Already as asked$
   -  AppArmor             Status only$
   -  Auto Updates         Turn on$
   -  DNS                  Set 2 nameservers$
   -  Backups              Used, not changed$
   -  Environment          Nothing asked$
$
  Select an option$
$
   1) Apply all            Plan, review, confirm$
                           [ ] Lockout risk$
$
   0) Return$
$
    > Enter your choice [0-1 or q]: 1$
$
# Warning$
# Firewall skipped: hardn can't tell which ports SSH uses: ss$
# isn't installed. Install iproute2, then try again.$
$
# Apply all ####################################################$
$
  Run All ------------------------------------------------------$
$
   -  SSH Login            Root login off$
   -  Auto Updates         Turn on$
   -  DNS                  Set 2 nameservers$
  [ ] dhcpcd may rewrite /etc/resolv.conf on a lease$
$
   -  Install hardn's boot unit$
      /etc/init.d/hardn-boot$
      @@ -0,0 +1,23 @@$
      +#!/sbin/openrc-run$
      +# hardn's boot service (P-34 (c);$
      | docs/safety/revert-boot.md). hardn installs$
      +# it before it arms the revert timer of a change that$
      | could lock you out, and$
      +# removes it at a boot that finds no change journalled.$
      +#$
      +# At boot, before sshd starts: re-arm the revert timer of$
      | a change waiting$
      +# for "hardn confirm", for what remains of its window, or$
      | roll the change$
      +# back when its deadline has passed. Ordering only: sshd$
      | starts whatever$
      +# this service does.$
      +$
      +description="hardn: re-arm or run the revert timer of an$
      | unconfirmed change"$
      +$
      +depend() {$
      +    need localmount$
      +    after bootmisc firewall$
      +    before sshd$
      +}$
      +$
      +start() {$
      +    ebegin "hardn: checking the change journal"$
      +    /usr/local/bin/hardn rollback --boot$
      +    eend $?$
      +}$
      -not installed$
      +installed and enabled$
      $ sh -n /run/hardn/20261020T120000Z-xxxxxxxx/hardn-boot$
      $ rc-update add hardn-boot default$
$
   -  Turn on daily upgrades$
      crond$
      -apk-cron not installed, crond stopped$
      +apk-cron installed, crond started at boot$
      $ apk add apk-cron$
      $ rc-update add crond default$
      $ rc-service crond start$
$
  [ ] Lockout risk$
      Disallow root login$
$
      /etc/ssh/sshd_config.d/00-hardn.conf$
      @@ -0,0 +1,3 @@$
      +# Managed by hardn.$
      +# Set by hardn:$
      +PermitRootLogin no$
$
   -  Set the nameservers$
      /etc/resolv.conf$
      @@ -1,3 +1,4 @@$
       # Generated by dhcpcd from eth0.dhcp$
       search example.net$
      -nameserver 192.0.2.1$
      +nameserver 192.0.2.54$
      +nameserver 2001:db8::54$
$
  [ ] Lockout risk$
      Reload sshd (openrc sshd)$
$
      sshd$
      $ rc-service sshd reload$
$
  [ ] Lockout risk$
      sshd -T shows no root login$
$
      sshd -T$
      $ sshd -T$
$
   -  Record hardn's changes$
      /var/lib/hardn/controls/updates.auto.json$
$
  Apply this plan?$
$
  Type the hostname [web-01, 0 or q]: web-01$
$
  [+] Install hardn's boot unit    Done$
  [+] Turn on daily upgrades       Done$
  [+] Disallow root login          Done$
  [+] Set the nameservers          Done$
  [+] Reload sshd (openrc sshd)    Done$
  [+] sshd -T shows no root login  Done$
  [+] Record hardn's changes       Done$
$
# Operation Successful$
$
# Warning$
# This change reverts automatically in 3:00$
# To keep it, open a new SSH session and run:$
$
      $ doas hardn confirm$
$
  Unless confirmed, change 20261020T120000Z-xxxxxxxx is rolled$
  back at about 12:03:00 UTC. To undo it now, run doas hardn$
  rollback 20261020T120000Z-xxxxxxxx.$
$
  Backup of /etc/resolv.conf kept in$
  /var/backups/hardn/20261020T120000Z-xxxxxxxx$
$
# Run All ######################################################$
$
  Controls -----------------------------------------------------$
$
   -  User                 Change pending$
   -  Firewall             Change pending$
   -  SSH Login            Change pending$
   -  SSH Auth             Nothing asked$
   -  SSH Port             Already as asked$
   -  AppArmor             Status only$
   -  Auto Updates         Change pending$
   -  DNS                  Change pending$
   -  Backups              Used, not changed$
   -  Environment          Nothing asked$
$
  Select an option$
$
   1) Apply all            Change pending$
$
   0) Return$
$
    > Enter your choice [0-1 or q]: 0$
$
  simulated system ---------------------------------------------$
$
# Info: runall/alpine323$
# Recorded by the fake, not done: what each step ran on web-$
# 01.example.net, and the files it changed, in order; hardn's$
# own journal, run directory and backups left out.$
$
   -  Before the first change$
      $ rc-service crond status$
      $ rc-service crond status$
      $ rc-service crond status$
      $ rc-service crond status$
$
   -  Applied: Install hardn's boot unit$
      /etc/init.d/hardn-boot$
      $ rc-update add hardn-boot default$
$
   -  Armed the revert timer$
      $ /bin/sh -c "sleep \"$1\" && \"$0\" rollback \"$2\""$
      | /usr/local/bin/hardn 180 20261020T120000Z-xxxxxxxx$
$
   -  Applied: Turn on daily upgrades$
      $ rc-service crond status$
      $ apk add apk-cron$
      $ rc-update add crond default$
      $ rc-service crond start$
      $ rc-service crond status$
$
   -  Applied: Disallow root login$
      /etc/ssh/sshd_config.d/00-hardn.conf$
$
   -  Applied: Set the nameservers$
      /etc/resolv.conf$
$
   -  Applied: Reload sshd (openrc sshd)$
      $ rc-service sshd reload$
$
   -  Applied: Record hardn's changes$
      $ rc-service crond status$
$

