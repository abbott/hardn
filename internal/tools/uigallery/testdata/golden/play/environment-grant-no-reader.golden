=== plain-80: width 80, height 24, profile notty, dark, glyphs ascii, plain
# play environment/grant-no-reader -----------------------------$
$
# Note$
# Play mode, mocks: the Environment screen proposed for slice 9,$
# drawn from what real code reads of a simulated host$
# (sudoers.Choose, Read, PlanFor), each change on the real$
# plan/apply engine (steps.Sudoers). Who ran hardn, the reader$
# of hardn's files and the plan's findings on the change are the$
# gallery's, unit (b)'s to build. Nothing on this machine$
# changes: every command and file is the fake's, and its record$
# is shown when play ends.$
$
# Info: environment/grant-no-reader$
# web-01.example.net runs Debian 13, sudo 1.9.16p2. As grant,$
# planned as real code can today: an env-only Policy, which$
# removes hardn's grant.$
$
# Environment Variable Settings ################################$
$
# HARDN_CONFIG -------------------------------------------------$
$
   -  User                 alice$
  [ ] Under sudo           Not kept$
   -  Value                Not set$
$
  Select an option$
$
   1) Under sudo           Keep HARDN_CONFIG$
                           [ ] Lockout risk$
   2) Guide                How to set HARDN_CONFIG$
$
   0) Return$
$
  > Enter selection [0-2 or q]: 1$
$
# Keep HARDN_CONFIG ############################################$
$
# HARDN_CONFIG -------------------------------------------------$
$
   -  User                 alice$
  [+] Under sudo           Kept$
$
   -  Install hardn's boot unit$
      /etc/systemd/system/hardn-boot.service$
      @@ -0,0 +1,23 @@$
      +# hardn's boot unit (P-34 (c);$
      | docs/safety/revert-boot.md). hardn installs$
      +# it before it arms the revert timer of a change that$
      | could lock you out, and$
      +# removes it at a boot that finds no change journalled.$
      +#$
      +# At boot, before sshd reads its files: re-arm the revert$
      | timer of a change$
      +# waiting for "hardn confirm", for what remains of its$
      | window, or roll the$
      +# change back when its deadline has passed. Ordering$
      | only: sshd starts$
      +# whatever this unit does.$
      +[Unit]$
      +Description=hardn: re-arm or run the revert timer of an$
      | unconfirmed change$
      +DefaultDependencies=no$
      +After=local-fs.target sysinit.target ufw.service$
      +Before=ssh.service ssh.socket shutdown.target$
      +Conflicts=shutdown.target$
      +$
      +[Service]$
      +Type=oneshot$
      +RemainAfterExit=yes$
      +ExecStart=/usr/local/bin/hardn rollback --boot$
      +TimeoutStartSec=7min$
      +$
      +[Install]$
      +WantedBy=multi-user.target$
      -not installed$
      +installed and enabled$
      $ systemd-analyze verify --recursive-errors=no$
      | /run/hardn/20261020T120000Z-xxxxxxxx/hardn-boot.service$
      $ systemctl --no-reload enable hardn-boot.service$
$
  [ ] Lockout risk$
      Keep HARDN_CONFIG$
$
      /etc/sudoers.d/hardn-grant-alice,$
      | /etc/sudoers.d/hardn-env-alice$
      --- /etc/sudoers.d/hardn-grant-alice$
      +++ /dev/null$
      @@ -1,2 +0,0 @@$
      -# Managed by hardn$
      -alice ALL=(ALL) NOPASSWD: ALL$
      --- /dev/null$
      +++ /etc/sudoers.d/hardn-env-alice$
      @@ -0,0 +1,2 @@$
      +# Managed by hardn$
      +Defaults:alice env_keep += "HARDN_CONFIG"$
$
  Keep HARDN_CONFIG under sudo?$
$
  Type the hostname [web-01, 0 or q]: 0$
$
# Operation Cancelled$
$
# Environment Variable Settings ################################$
$
# HARDN_CONFIG -------------------------------------------------$
$
   -  User                 alice$
  [ ] Under sudo           Not kept$
   -  Value                Not set$
$
  Select an option$
$
   1) Under sudo           Keep HARDN_CONFIG$
                           [ ] Lockout risk$
   2) Guide                How to set HARDN_CONFIG$
$
   0) Return$
$
  > Enter selection [0-2 or q]: 0$
$
# simulated system ---------------------------------------------$
$
# Note$
# Nothing was applied.$
$

