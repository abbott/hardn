=== plain-80: width 80, height 24, profile notty, dark, glyphs ascii, plain
# play runall/debian13 -----------------------------------------$
$
# Note$
# Play mode, mocks: the Run All screen proposed for slice 8,$
# each row's state from the control's real Check, each change$
# the real control's Plan, all of them in one plan on the real$
# plan/apply engine. Which controls hardn.yml asks for, how a$
# row is skipped and a change pending read before any plan are$
# Run All's planner's (pkg/engine/runall); the hostname asked$
# whatever the risk is the gallery's stand-in, unit (c)'s to$
# build. Nothing on this machine changes: every command and file$
# is the fake's.$
$
# Info: runall/debian13$
# web-01.example.net runs Debian 13. As the VM: george (two$
# keys, sudo by cloud-init) and alice, ufw allowing 22,$
# unattended-upgrades on by the package. hardn.yml: george with$
# a key, port 22, two nameservers, backups on, and$
# enableUnattendedUpgrades, enableUfwSshPolicy, configureDns and$
# disableRootSSH true. george logged in by key, hardn through$
# sudo.$
$
# Run All ######################################################$
$
# Controls -----------------------------------------------------$
$
   -  User                 Already as asked$
   -  Firewall             Already as asked$
   -  SSH Login            Root login off$
   -  SSH Auth             Nothing asked$
   -  SSH Port             Already as asked$
   -  AppArmor             Status only$
   -  Auto Updates         Already as asked$
   -  DNS                  Set 2 nameservers$
   -  Backups              Used, not changed$
   -  Environment          Nothing asked$
$
  Select an option$
$
   1) Apply all            Plan, review, confirm$
                           [ ] Lockout risk$
$
   0) Return$
$
  > Enter your choice [0-1 or q]: 1$
$
# Apply all ####################################################$
$
# Run All ------------------------------------------------------$
$
   -  SSH Login            Root login off$
   -  DNS                  Set 2 nameservers$
  [ ] dhcpcd may rewrite /etc/resolv.conf on a lease$
$
   -  Install hardn's boot unit$
      /etc/systemd/system/hardn-boot.service$
      @@ -0,0 +1,23 @@$
      +# hardn's boot unit (P-34 (c);$
      | docs/safety/revert-boot.md). hardn installs$
      +# it before it arms the revert timer of a change that$
      | could lock you out, and$
      +# removes it at a boot that finds no change journalled.$
      +#$
      +# At boot, before sshd reads its files: re-arm the revert$
      | timer of a change$
      +# waiting for "hardn confirm", for what remains of its$
      | window, or roll the$
      +# change back when its deadline has passed. Ordering$
      | only: sshd starts$
      +# whatever this unit does.$
      +[Unit]$
      +Description=hardn: re-arm or run the revert timer of an$
      | unconfirmed change$
      +DefaultDependencies=no$
      +After=local-fs.target sysinit.target ufw.service$
      +Before=ssh.service ssh.socket shutdown.target$
      +Conflicts=shutdown.target$
      +$
      +[Service]$
      +Type=oneshot$
      +RemainAfterExit=yes$
      +ExecStart=/usr/local/bin/hardn rollback --boot$
      +TimeoutStartSec=7min$
      +$
      +[Install]$
      +WantedBy=multi-user.target$
      -not installed$
      +installed and enabled$
      $ systemd-analyze verify --recursive-errors=no$
      | /run/hardn/20261020T120000Z-xxxxxxxx/hardn-boot.service$
      $ systemctl --no-reload enable hardn-boot.service$
$
  [ ] Lockout risk$
      Disallow root login$
$
      /etc/ssh/sshd_config.d/00-hardn.conf$
      @@ -0,0 +1,3 @@$
