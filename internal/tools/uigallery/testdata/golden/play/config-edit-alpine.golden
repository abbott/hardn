=== plain-80: width 80, height 24, profile notty, dark, glyphs ascii, plain
  play config/alpine-tcp ---------------------------------------$
$
# Note$
# Play mode: hardn's Configuration screen (pkg/screens/config),$
# proposed with no Figma frame, on a hardn.yml loaded by the$
# real loader (pkg/config) from a simulated host. Edit a setting$
# saves one key to that host's file through the real engine.$
# Nothing on this machine changes or is read.$
$
# Info: config/alpine-tcp$
# The typical file with a TCP syslog server, on Alpine 3.23,$
# whose busybox syslogd forwards over UDP only: a line under$
# syslogServers says so.$
$
# Configuration ################################################$
$
  File ---------------------------------------------------------$
$
   -  Path                 /etc/hardn/hardn.yml$
   -  From                 Search path$
$
  Users --------------------------------------------------------$
$
   -  username             george$
   -  adminNoPassword      false (default)$
   -  sshKeys              1 key$
$
  SSH ----------------------------------------------------------$
$
   -  sshPort              2222$
   -  disableRootSSH       true$
   -  sshConfigFile$
      /etc/ssh/sshd_config.d/hardn.conf (default)$
$
  Firewall -----------------------------------------------------$
$
   -  enableUfwSshPolicy   true$
   -  ufwAppProfiles       tailscale$
   -  ufwTrustedInterfaces None (default)$
$
  DNS ----------------------------------------------------------$
$
   -  configureDns         true$
   -  nameservers          2: 1.1.1.1, 1.0.0.1$
$
  Auto Updates -------------------------------------------------$
$
   -  enableAutoUpdates    true$
$
  Syslog -------------------------------------------------------$
$
   -  syslogServers        192.0.2.50$
  [ ] busybox syslogd is UDP only. Change protocol under Edit a$
      setting.$
$
  NTP ----------------------------------------------------------$
$
   -  ntpServers           None (default)$
$
  Kernel -------------------------------------------------------$
$
   -  kernel               false (default)$
$
  Backup -------------------------------------------------------$
$
   -  enableBackups        true (default)$
   -  backupPath           /var/backups/hardn (default)$
$
  General ------------------------------------------------------$
$
   -  dryRun               false (default)$
   -  confirmTimeout       3m (default)$
   -  checkReleases        false (default)$
$
  Select an option$
$
   1) Edit a setting       Change a key in hardn.yml$
$
   0) Return$
$
    > Option [0-1 or q]: 1$
$
# Edit a setting ###############################################$
$
   1) username             george$
   2) sshKeys              1 key$
   3) sshPort              2222$
   4) disableRootSSH       true$
   5) enableUfwSshPolicy   true$
   6) configureDns         true$
   7) syslogServers        192.0.2.50$
   8) ntpServers           None$
   9) kernel               false$
  10) confirmTimeout       3m$
  11) checkReleases        false$
  12) enableAutoUpdates    true$
$
   0) Return$
$
    > Option [0-12 or q]: 7$
$
# syslogServers ################################################$
$
  Servers ------------------------------------------------------$
$
   -  Server               192.0.2.50:514 TCP$
  [ ] busybox syslogd is UDP only. Change protocol under Edit a$
      setting.$
$
   1) Add server$
   2) Remove server$
   3) Change protocol$
$
   0) Return$
$
    > Option [0-3 or q]: 1$
$
# syslogServers ################################################$
$
   1. Enter syslog server [0 or q]: 192.0.2.51$
$
   2. Enter protocol [tcp] [0 or q]: $
   2. Enter protocol [tcp]: tcp$
$
   3. Enter port [514] [0 or q]: $
