# play main-menu/00-tui-main -----------------------------------$
$
# Note$
# Play mode: hardn's own screens and prompts, on the gallery's$
# fixture plans. Nothing on this machine changes: the simulated$
# system only records each step it would apply, and the record$
# is shown when play ends.$
$
hardn  v0.4.0              https://github.com/abbott/hardn$
$
# Debian 12 (Bookworm) #########################################$
$
  [BOS-SAN-L01]            192.0.2.10$
                           182 days, 2 hours, 26 minutes$
$
  [*] Risk Level           Moderate ~ medium security$
$
  [+] User                 Configured non-root, sudo$
  [+] Firewall             Configured deny policy$
  [+] SSH Login            Configured root disallowed$
  [+] SSH Auth             Configured key-only auth$
  [+] SSH Port             Configured non-default (2230)$
  [ ] AppArmor             Not Configured$
  [ ] Auto Updates         Not Configured$
$
----------------------------------------------------------------$
$
  Select an option         Mode Live$
$
   1) User Management      Create, Configure (sudo, SSH keys)$
   2) SSH Login            Toggle SSH root access$
   3) DNS                  Configure Nameservers$
   4) Firewall             Configure UFW rules$
   5) Backup               Configure Hardn backup settings$
   6) Auto Updates         Configure automatic updates$
   7) Run All              Execute hardening operations$
   8) Environment          Keep HARDN_CONFIG$
   9) System Details       View system information$
  10) Logs                 View log file$
$
   0) Exit                 q to quit$
$
  > Enter selection [0-10 or q]: 2$
$
# Info: ssh/debian13$
# web-01.example.net runs Debian 13 (OpenSSH 10.0p2). As the VM:$
# the stock Include first, PasswordAuthentication no, UsePAM$
# yes; root "*" with george's first key; george "!", two keys,$
# sudo by cloud-init; alice a password, no key, in sudo; ufw$
# allows 22 from anywhere; the old hardn.yml. george logged in$
# by key, hardn through sudo.$
$
# SSH Login ####################################################$
$
  [ ] SSH Login            Partial root key-only$
  [+] SSH Auth             Configured key-only auth$
  [ ] SSH Port             Not Configured default (22)$
$
# SSH Configuration --------------------------------------------$
$
   -  Root SSH Login       Key only sshd's default$
   -  Password Login       Off by sshd_config$
   -  SSH Port             22$
   -  Allowed Users        Anyone$
   -  Logged in as         george, by key$
$
  Select an option$
$
   1) Disallow root login  Root can't log in over SSH$
   2) Password login on    Let passwords log in again$
   3) Change SSH port      Now 22$
$
   0) Return$
$
  > Enter your choice [0-3 or q]: 1$
$
# Disallow root login ##########################################$
$
# SSH Configuration --------------------------------------------$
$
   -  Root SSH Login       Disallowed$
$
   -  Install hardn's boot unit$
      /etc/systemd/system/hardn-boot.service$
      @@ -0,0 +1,23 @@$
      +# hardn's boot unit (P-34 (c);$
      | docs/safety/revert-boot.md). hardn installs$
      +# it before it arms the revert timer of a change that$
      | could lock you out, and$
      +# removes it at a boot that finds no change journalled.$
      +#$
      +# At boot, before sshd reads its files: re-arm the revert$
      | timer of a change$
      +# waiting for "hardn confirm", for what remains of its$
      | window, or roll the$
      +# change back when its deadline has passed. Ordering$
      | only: sshd starts$
      +# whatever this unit does.$
      +[Unit]$
      +Description=hardn: re-arm or run the revert timer of an$
      | unconfirmed change$
      +DefaultDependencies=no$
      +After=local-fs.target sysinit.target ufw.service$
      +Before=ssh.service ssh.socket shutdown.target$
      +Conflicts=shutdown.target$
      +$
      +[Service]$
      +Type=oneshot$
      +RemainAfterExit=yes$
      +ExecStart=/usr/local/bin/hardn rollback --boot$
      +TimeoutStartSec=7min$
      +$
      +[Install]$
      +WantedBy=multi-user.target$
      -not installed$
      +installed and enabled$
      $ systemd-analyze verify --recursive-errors=no$
      | /run/hardn/20261020T120000Z-xxxxxxxx/hardn-boot.service$
      $ systemctl --no-reload enable hardn-boot.service$
$
  [ ] Lockout risk$
      Disallow root login$
$
      /etc/ssh/sshd_config.d/00-hardn.conf$
      @@ -0,0 +1,3 @@$
      +# Managed by hardn.$
      +# Set by hardn:$
      +PermitRootLogin no$
$
  [ ] Lockout risk$
      Reload sshd (ssh.service)$
$
      ssh.service$
      $ systemctl reload ssh.service$
$
  [ ] Lockout risk$
      sshd -T shows no root login$
$
      sshd -T$
      $ sshd -T$
$
  Disallow root login?$
$
  Type the hostname [web-01, 0 or q]: BOS-SAN-L01$
  (x) That does not match exactly. Please try again.$
  Type the hostname [web-01, 0 or q]: bos-san-l01$
  (x) That does not match exactly. Please try again.$
  Type the hostname [web-01, 0 or q]: q$
$
# simulated system ---------------------------------------------$
$
# Note$
# Nothing was applied.$
$

