      ␛[38;2;112;212;127m+Conflicts=shutdown.target␛[m$
      ␛[38;2;112;212;127m+␛[m$
      ␛[38;2;112;212;127m+[Service]␛[m$
      ␛[38;2;112;212;127m+Type=oneshot␛[m$
      ␛[38;2;112;212;127m+RemainAfterExit=yes␛[m$
