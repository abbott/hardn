=== plain-80: width 80, height 24, profile notty, dark, glyphs ascii, plain
  play engine/confirm-cleanup-debian13 -------------------------$
$
# Note$
# Play mode: hardn's own screens and prompts, on the real$
# plan/apply engine against a simulated host, hostfake's$
# recording host.System, whose commands a model of the host$
# answers. Nothing on this machine changes: every command and$
# file is the fake's, and its record is shown when play ends.$
$
# Info: engine/confirm-cleanup-debian13$
# web-01.example.net runs Debian 13; sshd listens on port 22,$
# and ufw is installed, inactive, with no rules.$
# The change: SSH port 2230 with ufw enabled, port 22 and its$
# rule held until confirmed. Type the hostname, web-01, to apply$
# it; 0 declines.$
# Then a new SSH connection to port 2230 confirms it with hardn$
# confirm, which drops port 22 and the rule hardn added for it$
# (P-40).$
$
   -  Install hardn's boot unit$
      /etc/systemd/system/hardn-boot.service$
      @@ -0,0 +1,23 @@$
      +# hardn's boot unit (P-34 (c);$
      | docs/safety/revert-boot.md). hardn installs$
      +# it before it arms the revert timer of a change that$
      | could lock you out, and$
      +# removes it at a boot that finds no change journalled.$
      +#$
      +# At boot, before sshd reads its files: re-arm the revert$
      | timer of a change$
      +# waiting for "hardn confirm", for what remains of its$
      | window, or roll the$
      +# change back when its deadline has passed. Ordering$
      | only: sshd starts$
      +# whatever this unit does.$
      +[Unit]$
      +Description=hardn: re-arm or run the revert timer of an$
      | unconfirmed change$
      +DefaultDependencies=no$
      +After=local-fs.target sysinit.target ufw.service$
      +Before=ssh.service ssh.socket sshd.service sshd.socket$
      | shutdown.target$
      +Conflicts=shutdown.target$
      +$
      +[Service]$
      +Type=oneshot$
      +RemainAfterExit=yes$
      +ExecStart=/usr/local/bin/hardn rollback --boot$
      +TimeoutStartSec=7min$
      +$
      +[Install]$
      +WantedBy=multi-user.target$
      -not installed$
      +installed and enabled$
      $ systemd-analyze verify --recursive-errors=no$
      | /run/hardn/20261020T120000Z-xxxxxxxx/hardn-boot.service$
      $ systemctl --no-reload enable hardn-boot.service$
$
  [ ] Lockout risk$
      ufw: allow 22/tcp, 2230/tcp; enable$
$
      ufw$
      -inactive$
      +active$
      $ ufw allow 22/tcp$
      $ ufw allow 2230/tcp$
      $ ufw --force enable$
$
  [ ] Lockout risk$
      Add SSH port 2230$
$
      /etc/ssh/sshd_config.d/00-hardn.conf$
      @@ -0,0 +1,4 @@$
      +# Managed by hardn.$
      +# Set by hardn:$
      +Port 22$
      +Port 2230$
$
  [ ] Lockout risk$
      Reload sshd (ssh.service)$
$
      ssh.service$
      $ systemctl reload ssh.service$
$
  [ ] Lockout risk$
      sshd -T shows ports 22, 2230$
$
      sshd -T$
      $ sshd -T$
$
  Change the SSH port to 2230 and enable ufw?$
$
  Type the hostname [web-01, 0 or q]: web-01$
$
  [+] Install hardn's boot unit            Done$
  [+] ufw: allow 22/tcp, 2230/tcp; enable  Done$
  [+] Add SSH port 2230                    Done$
  [+] Reload sshd (ssh.service)            Done$
  [+] sshd -T shows ports 22, 2230         Done$
$
# Operation Successful$
$
# Warning$
# This change reverts automatically in 3:01$
# To keep it, open a new SSH session on port 2230 and run:$
$
      $ sudo hardn confirm$
$
  Unless confirmed, change 20261020T120000Z-xxxxxxxx is rolled$
  back at 12:03:01 UTC. To undo it now, run sudo hardn rollback$
  20261020T120000Z-xxxxxxxx.$
$
# Info: hardn confirm, from a new connection to port 2230$
# alice opens a new SSH connection to web-01.example.net on port$
# 2230, from 192.0.2.10, and runs sudo hardn confirm.$
$
# Operation Successful$
# Change 20261020T120000Z-xxxxxxxx confirmed (4 changes: SSH):$
# it will not be rolled back.$
$
