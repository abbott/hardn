=== plain-80: width 80, height 24, profile notty, dark, glyphs ascii, plain
  play engine/ufw-enable-debian13 ------------------------------$
$
# Note$
# Play mode: hardn's own screens and prompts, on the real$
# plan/apply engine against a simulated host, hostfake's$
# recording host.System, whose commands a model of the host$
# answers. Nothing on this machine changes: every command and$
# file is the fake's, and its record is shown when play ends.$
$
# Info: engine/ufw-enable-debian13$
# web-01.example.net runs Debian 13; sshd listens on port 22,$
# and ufw is installed, inactive, with no rules.$
# The change: ufw enabled, sshd's listeners allowed first. Type$
# the hostname, web-01, to apply it; 0 declines.$
$
   -  Install hardn's boot unit$
      /etc/systemd/system/hardn-boot.service$
      @@ -0,0 +1,23 @@$
      +# hardn's boot unit (P-34 (c);$
      | docs/safety/revert-boot.md). hardn installs$
      +# it before it arms the revert timer of a change that$
      | could lock you out, and$
      +# removes it at a boot that finds no change journalled.$
      +#$
      +# At boot, before sshd reads its files: re-arm the revert$
      | timer of a change$
      +# waiting for "hardn confirm", for what remains of its$
      | window, or roll the$
      +# change back when its deadline has passed. Ordering$
      | only: sshd starts$
      +# whatever this unit does.$
      +[Unit]$
      +Description=hardn: re-arm or run the revert timer of an$
      | unconfirmed change$
      +DefaultDependencies=no$
      +After=local-fs.target sysinit.target ufw.service$
      +Before=ssh.service ssh.socket sshd.service sshd.socket$
      | shutdown.target$
      +Conflicts=shutdown.target$
      +$
      +[Service]$
      +Type=oneshot$
      +RemainAfterExit=yes$
      +ExecStart=/usr/local/bin/hardn rollback --boot$
      +TimeoutStartSec=7min$
      +$
      +[Install]$
      +WantedBy=multi-user.target$
      -not installed$
      +installed and enabled$
      $ systemd-analyze verify --recursive-errors=no$
      | /run/hardn/20261020T120000Z-xxxxxxxx/hardn-boot.service$
      $ systemctl --no-reload enable hardn-boot.service$
$
  [ ] Lockout risk$
      ufw: allow 22/tcp; enable$
$
      ufw$
      -inactive$
      +active$
      $ ufw allow 22/tcp$
      $ ufw --force enable$
$
  Enable ufw?$
$
  Type the hostname [web-01, 0 or q]: web-01$
$
  [+] Install hardn's boot unit  Done$
  [+] ufw: allow 22/tcp; enable  Done$
$
# Operation Successful$
$
# Warning$
# This change reverts automatically in 3:01$
# To keep it, open a new SSH session and run:$
$
      $ sudo hardn confirm$
$
  Unless confirmed, change 20261020T120000Z-xxxxxxxx is rolled$
  back at 12:03:01 UTC. To undo it now, run$
  `sudo hardn rollback 20261020T120000Z-xxxxxxxx`.$
$
  simulated system ---------------------------------------------$
$
# Info: engine/ufw-enable-debian13$
# Recorded by the fake, not done: what each step ran on$
# web-01.example.net, and the files it changed, in order;$
# hardn's own journal, run directory and backups left out.$
$
   -  Applied: Install hardn's boot unit$
      /etc/systemd/system/hardn-boot.service$
      $ systemctl --no-reload enable hardn-boot.service$
$
   -  Armed the revert timer$
      $ systemd-run$
      | --unit=hardn-revert-20261020T120000Z-xxxxxxxx$
      | "--description=hardn: roll back change$
      | 20261020T120000Z-xxxxxxxx unless confirmed"$
      | --on-active=180s --timer-property=AccuracySec=1s$
      | /usr/local/bin/hardn rollback 20261020T120000Z-xxxxxxxx$
$
   -  Applied: ufw: allow 22/tcp; enable$
      $ ufw allow 22/tcp$
      $ ufw --force enable$
$

