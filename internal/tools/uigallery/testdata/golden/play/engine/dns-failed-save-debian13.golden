=== plain-80: width 80, height 24, profile notty, dark, glyphs ascii, plain
# play engine/dns-failed-save-debian13 -------------------------$
$
# Note$
# Play mode: hardn's own screens and prompts, on the real$
# plan/apply engine against a simulated host, hostfake's$
# recording host.System, whose commands a model of the host$
# answers. Nothing on this machine changes: every command and$
# file is the fake's, and its record is shown when play ends.$
$
# Info: engine/dns-failed-save-debian13$
# web-01.example.net runs Debian 13; /etc/resolv.conf is a file$
# dhcpcd wrote from eth0's lease, naming 192.0.2.1. hardn.yml$
# lists 192.0.2.54, 2001:db8::54. hardn.yml is immutable (chattr$
# +i), so saving it fails.$
# The change: Use Cloudflare DNS, 1.1.1.1 and 1.0.0.1, then$
# hardn.yml saved with that list. y applies it; n declines.$
$
   -  Set the nameservers$
      /etc/resolv.conf$
      @@ -1,3 +1,4 @@$
       # Generated by dhcpcd from eth0.dhcp$
       search example.net$
      -nameserver 192.0.2.1$
      +nameserver 1.1.1.1$
      +nameserver 1.0.0.1$
$
   -  Save the configuration$
      /etc/hardn/hardn.yml$
      @@ -1,5 +1,51 @@$
      -# hardn's configuration (web-01.example.net)$
       username: alice$
      +logFile: /var/log/hardn.log$
      +dryRun: false$
      +enableBackups: true$
      +backupPath: /var/backups/hardn$
      +dmzSubnet: ""$
       nameservers:$
      -  - "192.0.2.54"$
      -  - "2001:db8::54"$
      +    - 1.1.1.1$
      +    - 1.0.0.1$
      +sshPort: 22$
      +permitRootLogin: "no"$
      +sshAllowedUsers: []$
      +sshListenAddress: 0.0.0.0$
      +sshKeyPath: .ssh_%u$
      +sshConfigFile: /etc/ssh/sshd_config.d/hardn.conf$
      +sudoNoPassword: true$
      +sshKeys: []$
      +linuxCorePackages: []$
      +linuxDmzPackages: []$
      +linuxLabPackages: []$
      +pythonPackages: []$
      +nonWslPythonPackages: []$
      +pythonPipPackages: []$
      +alpineCorePackages: []$
      +alpineDmzPackages: []$
      +alpineLabPackages: []$
      +alpinePythonPackages: []$
      +debianRepos: []$
      +proxmoxSrcRepos: []$
      +proxmoxCephRepo: []$
      +proxmoxEnterpriseRepo: []$
      +proxmoxPackagePatterns: []$
      +alpineTestingRepo: false$
      +ufwAppProfiles: []$
      +ufwDefaultIncomingPolicy: ""$
      +ufwDefaultOutgoingPolicy: ""$
      +ufwAllowedPorts: []$
      +useUvPackageManager: false$
      +enableAppArmor: false$
      +enableLynis: false$
      +enableUnattendedUpgrades: false$
      +enableUfwSshPolicy: false$
      +configureDns: false$
      +disableRootSSH: false$
      +lang: ""$
      +language: ""$
      +lcAll: ""$
      +tz: ""$
      +pythonUnbuffered: "1"$
      +logsconfig:$
      +    logfilepath: ""$
$
  Use Cloudflare DNS? [y/N, 0 or q]: y$
$
  [+] Set the nameservers     Done$
  [ ] Save the configuration  Failed PERMISSION_DENIED$
$
# Operation Failed$
# Saving /etc/hardn/hardn.yml failed$
$
  [ ] Set the nameservers     Rolled back$
$
  Check the log file at /var/log/hardn.log for details$
$
# Warning$
# dhcpcd may rewrite /etc/resolv.conf on a lease$
# (DNS_DHCP_CLIENT, /usr/sbin/dhcpcd)$
# Saving hardn.yml loses its comments (CONFIG_COMMENTS_LOST,$
# /etc/hardn/hardn.yml)$
$
# simulated system ---------------------------------------------$
$
# Info: engine/dns-failed-save-debian13$
# Recorded by the fake, not done: what each step ran on web-$
# 01.example.net, and the files it changed, in order; hardn's$
# own journal, run directory and backups left out.$
$
   -  Applied: Set the nameservers$
      /etc/resolv.conf$
$
   -  Rolled back from the journal$
      /etc/resolv.conf$
$

