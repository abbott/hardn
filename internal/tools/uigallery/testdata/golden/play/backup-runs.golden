   -  Run                  20261018T091500Z-1a2b3c4d$
   -  Taken                2026-10-18 09:15 UTC$
$
   -  Restore /etc/hardn/hardn.yml$
      /etc/hardn/hardn.yml$
      @@ -1,4 +1,4 @@$
       # hardn's configuration (web-01.example.net)$
       username: alice$
      -enableBackups: true               # Backup files before$
      | modifying them$
      -backupPath: "/var/backups/hardn"  # Path to store backups$
      +nameservers:$
