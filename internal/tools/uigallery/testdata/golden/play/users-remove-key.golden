=== plain-80: width 80, height 24, profile notty, dark, glyphs ascii, plain
# play users/debian13 ------------------------------------------$
$
# Note$
# Play mode, mocks: the User Management screen proposed for$
# slice 5, drawn from the real control on a simulated host$
# (users.Read), each refusal the control's and each change$
# users.Admin's plan on the real plan/apply engine. Nothing on$
# this machine changes: every command and file is the fake's.$
$
# Info: users/debian13$
# web-01.example.net runs Debian 13. As the VM: george, uid$
# 1000, no password (!), in sudo and adm, two keys, NOPASSWD by$
# cloud-init's 90-cloud-init-users; alice, uid 1001, a password,$
# in sudo, no key. hardn runs through george's sudo.$
$
# User Management ##############################################$
$
  [+] User                 Configured non-root, sudo$
$
# george -------------------------------------------------------$
$
  [ ] Sudo                 Enabled, No password to ask for$
   -  Granted by           /etc/sudoers.d/90-cloud-init-users$
   -  SSH Keys             2 keys$
   -  Password             None$
$
# alice --------------------------------------------------------$
$
  [+] Sudo                 Enabled$
   -  Granted by           group sudo$
  [ ] SSH Keys             None$
   -  Password             Set$
$
  Select an option$
$
   1) Manage User          Configure sudo, SSH keys$
   2) Create User          Configure a new user$
$
   0) Return$
$
  > Enter your choice [0-2 or q]: 1$
$
# Manage User ##################################################$
$
  Select a user$
$
   1) george$
   2) alice$
$
   0) Return$
$
  > Enter your choice [0-2 or q]: 1$
$
# Manage User ##################################################$
$
  Managing: [george]$
$
# User Configuration -------------------------------------------$
$
  [ ] Sudo                 Enabled, No password to ask for$
   -  Granted by           /etc/sudoers.d/90-cloud-init-users$
   -  SSH Keys             2 keys$
   -  Password             None$
$
  Select an option$
$
   1) Remove admin rights  Take them away$
   2) Ask for password     For admin rights$
   3) SSH Keys             Add or remove SSH keys$
$
   0) Return$
$
  > Enter your choice [0-3 or q]: 3$
$
# Manage User ##################################################$
$
  Managing SSH keys for: [george]$
$
# SSH Keys -----------------------------------------------------$
$
   -  SHA256:RXm/ruZ0eTzRXKwi1AQEDynB0VgHQ2ac9KPSFdf/YnA$
      george@laptop-1$
   -  SHA256:baqJQcVDEweKmw1OiZxGooCG2MGxYtwsQQzzOstxmiA$
      george@laptop-2$
$
  Select an option$
$
   1) Add SSH key$
   2) Remove SSH key$
$
   0) Return$
$
  > Enter your choice [0-2 or q]: 2$
$
# Remove SSH key ###############################################$
$
  Remove which key?$
$
   1) SHA256:RXm/ruZ0eTzRXKwi1AQEDynB0VgHQ2ac9KPSFdf/YnA geor...$
   2) SHA256:baqJQcVDEweKmw1OiZxGooCG2MGxYtwsQQzzOstxmiA geor...$
$
  > Enter your choice [1-2, 0 or q]: 2$
  Remove which key?:$
      SHA256:baqJQcVDEweKmw1OiZxGooCG2MGxYtwsQQzzOstxmiA geor...$
$
# SSH Keys -----------------------------------------------------$
$
   -  SSH Keys             1 key$
$
   -  Install hardn's boot unit$
      /etc/systemd/system/hardn-boot.service$
      @@ -0,0 +1,23 @@$
      +# hardn's boot unit (P-34 (c);$
      | docs/safety/revert-boot.md). hardn installs$
      +# it before it arms the revert timer of a change that$
      | could lock you out, and$
      +# removes it at a boot that finds no change journalled.$
      +#$
      +# At boot, before sshd reads its files: re-arm the revert$
      | timer of a change$
      +# waiting for "hardn confirm", for what remains of its$
      | window, or roll the$
      +# change back when its deadline has passed. Ordering$
      | only: sshd starts$
      +# whatever this unit does.$
      +[Unit]$
      +Description=hardn: re-arm or run the revert timer of an$
      | unconfirmed change$
      +DefaultDependencies=no$
      +After=local-fs.target sysinit.target ufw.service$
      +Before=ssh.service ssh.socket shutdown.target$
      +Conflicts=shutdown.target$
      +$
      +[Service]$
      +Type=oneshot$
      +RemainAfterExit=yes$
      +ExecStart=/usr/local/bin/hardn rollback --boot$
      +TimeoutStartSec=7min$
      +$
      +[Install]$
      +WantedBy=multi-user.target$
      -not installed$
      +installed and enabled$
      $ systemd-analyze verify --recursive-errors=no$
      | /run/hardn/20261020T120000Z-xxxxxxxx/hardn-boot.service$
      $ systemctl --no-reload enable hardn-boot.service$
$
  [ ] Lockout risk$
      Remove a key from george$
$
      /home/george/.ssh/authorized_keys$
      @@ -1,2 +1 @@$
       ssh-ed25519$
      | AAAAC3NzaC1lZDI1NTE5AAAAIAEBAQEBAQEBAQEBAQEBAQEBAQEBAQEB$
      |AQEBAQEBAQEB george@laptop-1$
      -ssh-ed25519$
      | AAAAC3NzaC1lZDI1NTE5AAAAIAICAgICAgICAgICAgICAgICAgICAgIC$
      |AgICAgICAgIC george@laptop-2$
$
  Remove the key from george?$
$
  Type the hostname [web-01, 0 or q]: web-01$
$
  [+] Install hardn's boot unit  Done$
  [+] Remove a key from george   Done$
$
# Operation Successful$
$
# Warning$
# This change reverts automatically in 3:01$
# To keep it, open a new SSH session and run:$
$
      $ sudo hardn confirm$
$
  Unless confirmed, change 20261020T120000Z-xxxxxxxx is rolled$
  back at 12:03:01 UTC. To undo it now, run sudo hardn rollback$
  20261020T120000Z-xxxxxxxx.$
