# Note$
# Play mode: hardn's Configuration screen (pkg/screens/config),$
# proposed with no Figma frame, on a hardn.yml loaded by the$
# real loader (pkg/config) from a simulated host. Edit a setting$
# saves one key to that host's file through the real engine.$
# Nothing on this machine changes or is read.$
$
# Info: config/etc$
# A typical file, the first on the search path. A key the file$
# leaves out says default.$
$
# Configuration ################################################$
$
  File ---------------------------------------------------------$
$
   -  Path                 /etc/hardn/hardn.yml$
   -  From                 Search path$
$
  Users --------------------------------------------------------$
$
   -  username             george$
   -  adminNoPassword      false (default)$
   -  sshKeys              1 key$
$
  SSH ----------------------------------------------------------$
$
   -  sshPort              2222$
   -  disableRootSSH       true$
   -  sshConfigFile$
      /etc/ssh/sshd_config.d/hardn.conf (default)$
$
  Firewall -----------------------------------------------------$
$
   -  enableUfwSshPolicy   true$
   -  ufwAppProfiles       tailscale$
   -  ufwTrustedInterfaces None (default)$
$
  DNS ----------------------------------------------------------$
$
   -  configureDns         true$
   -  nameservers          2: 1.1.1.1, 1.0.0.1$
$
  Auto Updates -------------------------------------------------$
$
   -  enableUnattendedUpgrades$
      true$
$
  Syslog -------------------------------------------------------$
$
   -  syslogServers        None (default)$
$
  NTP ----------------------------------------------------------$
$
   -  ntpServers           None (default)$
$
  Kernel -------------------------------------------------------$
$
   -  kernel               false (default)$
$
  Backup -------------------------------------------------------$
$
   -  enableBackups        true (default)$
   -  backupPath           /var/backups/hardn (default)$
$
  General ------------------------------------------------------$
$
   -  dryRun               false (default)$
   -  confirmTimeout       3m (default)$
   -  checkReleases        false (default)$
$
  Select an option$
$
   1) Edit a setting       Change a key in hardn.yml$
