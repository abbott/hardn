# dryrun toggle ------------------------------------------------$
$
# Note$
# Mock (decision 4, alternative (a)). Enable dry-run mode saved$
# through the canonical flow: hardn.yml's dryRun edited in$
# place, then y.$
$
# toggle/1-confirm ---------------------------------------------$
$
# Enable dry-run mode ##########################################$
$
# Dry-Run Mode Configuration -----------------------------------$
$
  [+] Dry-run Mode         Enabled$
$
   -  Save the configuration$
      /etc/hardn/hardn.yml$
      @@ -1,6 +1,6 @@$
       # hardn's configuration (web-01.example.net)$
       username: alice$
      -dryRun: false$
      +dryRun: true$
       nameservers:$
         - "192.0.2.54"$
         - "2001:db8::54"$
$
  Enable dry-run mode? [y/N, 0 or q]: y$
$
# toggle/2-applied ---------------------------------------------$
$
  [+] Save the configuration  Done$
$
# Operation Successful$
$
$

