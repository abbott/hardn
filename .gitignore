# Ignore everything
*

# But not these files...
!/.gitignore

!*.go
!go.mod
!go.sum

!LICENSE
# README.md only at the root and under source/doc trees (not any README.md anywhere: that re-included
# untracked export READMEs). docs/**/README.md is covered by !docs/**/*.md.
!/README.md
!cmd/**/README.md
!pkg/**/README.md
!internal/**/README.md
!SUPPORT.md
!SECURITY.md
!GOVERNANCE.md
!CONTRIBUTING.md
!/ROADMAP.md

!Makefile
# Tracked as lowercase; listed explicitly so case-sensitive filesystems agree with macOS.
!makefile
!*.example

# Scripts
!verify.sh
!install.sh
!wf-dev-mode.sh
!wf-prepare-build.sh
!bin-postinstall.sh
!bin-verify-release.sh

!docs/**/*.md
!.github/**/*.yml
!.golangci.yml

# Test fixtures and golden files (Phase 0.7, 1D, 6)
!**/testdata/**
!*.golden

# Design-system review screenshots (freeze PNGs) and README images
!docs/**/*.png

# Allow directories (to enable more granular allow rules)
!*/

# vendor/ is not committed (go mod vendor regenerates it); keep below !*/ so this wins
/vendor/

# Allow .scratch directory itself
#!.scratch/

# Ignore all files inside .scratch/
dist/*
build/*
.scratch/*
.DS_Store